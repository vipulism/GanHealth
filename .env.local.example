# Copy to `.env.local` (gitignored). Nest loads this after `.env.*` / `.env` — same keys here override.
# Use the same DB as `.env` for now; later point `DATABASE_URL` at a dev-only DB.
# Prisma CLI (`npm run db:migrate`, etc.) reads `.env` in the repo root by default — keep `DATABASE_URL`
# there too, or run Prisma with an env that merges both files.

DATABASE_URL="mysql://USER:PASSWORD@db-host.example:3306/user_db"
PORT=3000
JWT_SECRET="your-jwt-secret-min-32-chars-long-please"

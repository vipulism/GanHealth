# Copy to `.env.local` (gitignored). Nest loads this after `.env.*` / `.env` — same keys here override.
# Use the same DB as `.env` for now; later point `DATABASE_URL` at a dev-only DB.
# Prisma CLI (`npm run db:migrate`, etc.) reads `.env` in the repo root by default — keep `DATABASE_URL`
# there too, or run Prisma with an env that merges both files.

DATABASE_URL="mysql://USER:PASSWORD@db-host.example:3306/user_db"
USER_SERVICE_PORT=3000
JWT_SECRET="your-jwt-secret-min-32-chars-long-please"

# api-gateway (Tier B): same JWT_SECRET; origins use LAN / Docker DNS per docs/INFRA-BASELINE.md
# Docker / compose network:
# USER_SERVICE_URL="http://user-service:3000"
# SECOND_SERVICE_URL="http://patient-service:3001"
# Gateway + user-service both on your machine (not on compose network): override URLs — hostnames like `user-service` will not resolve from the host.
# USER_SERVICE_URL="http://127.0.0.1:3000"
# SECOND_SERVICE_URL="http://127.0.0.1:3001"
# GATEWAY_PORT=3100
# UPSTREAM_TIMEOUT_MS=30000
# CORS_ORIGIN="http://app-host.example:4200"
